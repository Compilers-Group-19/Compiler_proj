// Sample program in the mini language
func int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

int count = 5;
float pi = 3.14;
bool ok = true;
string msg = "Result:\t";

/* block comment
   spanning lines */
while (count > 0 && ok != false) {
    print(msg);
    print(factorial(count));
    count = count - 1;
}
