int a = 7;
int b = 2;
print("a / b = ", a / b);
print("a % b = ", a % b);
print("-a / b = ", -a / b);
float x = a;
print("x / b = ", x / b);
print("1 + 2 * 3 = ", 1 + 2 * 3);
print("(1 + 2) * 3 = ", (1 + 2) * 3);
print("2.5 * 2 = ", 2.5 * 2);
print("10 - 4 - 3 = ", 10 - 4 - 3);
print("smallest = ", -9223372036854775808);
bool t = 1 < 2 && 2.5 >= 2;
print("t = ", t, ", !t = ", !t);
print("ints equal floats: ", 2 == 2.0);
string s = "mini";
print("strings equal: ", s == "mini", " ", s != "mini");
print("escapes:\tTab \"quoted\" \\ done");
int c = 5;
c = c * 2 + 1;
print("c = ", c);
int d;
float e;
bool g;
string h;
print("defaults: ", d, " ", e, " ", g, " [", h, "]");
int p = 1;
int q = p = 4;
print("p = ", p, ", q = ", q);
